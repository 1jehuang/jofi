#!/usr/bin/env bash
# Preserve the launch-origin context used by local desktop-entry helpers.
set -u
origin=$(niri msg -j focused-window 2>/dev/null || true)
if [[ -n "$origin" ]]; then
    export JSTACK_ORIGIN_WINDOW_ID JSTACK_ORIGIN_WINDOW_PID
    export JSTACK_ORIGIN_WINDOW_APP_ID JSTACK_ORIGIN_WORKSPACE_ID
    JSTACK_ORIGIN_WINDOW_ID=$(jq -r '.id // empty' <<<"$origin")
    JSTACK_ORIGIN_WINDOW_PID=$(jq -r '.pid // empty' <<<"$origin")
    JSTACK_ORIGIN_WINDOW_APP_ID=$(jq -r '.app_id // empty' <<<"$origin")
    JSTACK_ORIGIN_WORKSPACE_ID=$(jq -r '.workspace_id // empty' <<<"$origin")
fi
# Track the stable workspace ID, not its name: numeric names such as "4"
# are parsed as indexes by `niri msg action focus-workspace`.
workspace_id=$(niri msg -j workspaces 2>/dev/null | jq -r '.[] | select(.is_focused) | .id' || true)
# Jofi uses its own advisory lock, never kill another launcher or prompt.
launcher=${JOFI_BIN:-"$(dirname -- "${BASH_SOURCE[0]}")/jofi"}
if [[ -z ${JOFI_BIN:-} && ! -x "$launcher" ]]; then
    launcher=jofi
fi
"$launcher" "$@"
status=$?
if [[ $status -eq 0 && -n "$workspace_id" ]]; then
    # Normal launches already stay on the origin workspace. Do not issue a
    # redundant focus action that could interfere with the new window.
    workspaces=$(niri msg -j workspaces 2>/dev/null || true)
    current_id=$(jq -r '.[] | select(.is_focused) | .id' <<<"$workspaces" 2>/dev/null || true)
    if [[ -n "$current_id" && "$current_id" != "$workspace_id" ]]; then
        index=$(jq -r --arg id "$workspace_id" '.[] | select((.id | tostring) == $id) | .idx' <<<"$workspaces" 2>/dev/null || true)
        if [[ -n "$index" ]]; then
            niri msg action focus-workspace "$index" >/dev/null 2>&1 || true
        fi
    fi
fi
exit "$status"
